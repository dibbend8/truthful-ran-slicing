+        for (uint32_t sym = allocation.m_dci->m_symStart;
+             sym < static_cast<uint32_t>(allocation.m_dci->m_symStart + allocation.m_dci->m_numSym) &&
+             sym < symAny.size();
+             ++sym)
         {
-            symUsed += allocation.m_dci->m_numSym;
-
+            symAny[sym] = true;
             if (allocation.m_dci->m_type == DciInfoElementTdma::DATA ||
                 allocation.m_dci->m_type == DciInfoElementTdma::MSG3)
             {
-                dataSym += allocation.m_dci->m_numSym;
+                symData[sym] = true;
             }
             else
             {
-                ctrlSym += allocation.m_dci->m_numSym;
+                symCtrl[sym] = true;
             }
         }
 
         lastSymStart = allocation.m_dci->m_symStart;
     }
+    symUsed = static_cast<uint32_t>(std::count(symAny.begin(), symAny.end(), true));
+    dataSym = static_cast<uint32_t>(std::count(symData.begin(), symData.end(), true));
+    ctrlSym = static_cast<uint32_t>(std::count(symCtrl.begin(), symCtrl.end(), true));
 
     NS_ASSERT_MSG(symUsed == allocInfo.m_numSymAlloc,
                   "Allocated " << +allocInfo.m_numSymAlloc << " but only " << symUsed
