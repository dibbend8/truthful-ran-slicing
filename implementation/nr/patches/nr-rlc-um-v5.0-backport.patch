+static std::map<uint32_t, std::deque<std::string>> iccRepairHistory;
+static void RepairHistory(const char* kind,uint16_t rnti,uint8_t lcid,uint16_t sn,
+                          uint16_t expected,uint8_t fi,unsigned state,unsigned held,unsigned bytes){
+    std::ostringstream row;
+    row<<"{\"event\":\"rlc_repair_"<<kind<<"\",\"time_s\":"<<Simulator::Now().GetSeconds()
+       <<",\"rnti\":"<<rnti<<",\"lcid\":"<<unsigned(lcid)<<",\"sn\":"<<sn
+       <<",\"expected_sn\":"<<expected<<",\"fi\":"<<unsigned(fi)<<",\"state\":"<<state
+       <<",\"held_bytes\":"<<held<<",\"data_bytes\":"<<bytes<<"}";
+    auto& history=iccRepairHistory[(uint32_t(rnti)<<8)|lcid];
+    history.push_back(row.str());if(history.size()>128)history.pop_front();
+}
+extern "C" uint64_t IccNrRepairReassemblies() { return iccRepairReassemblies; }
+extern "C" uint64_t IccNrRepairTimerExpiries() { return iccRepairTimerExpiries; }
+extern "C" void IccNrRepairDumpHistory(){
+    for(const auto& [key,history]:iccRepairHistory)for(const auto& row:history)std::cerr<<row<<'\n';
+}
